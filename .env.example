# Bot token from https://discord.com/developers/applications -> Bot -> Reset Token
DISCORD_TOKEN=

# Application ID (General Information -> Application ID)
CLIENT_ID=

# Your server's ID (right-click the server icon -> Copy Server ID, needs Developer Mode on)
GUILD_ID=

# Role that can see and manage every ticket
SUPPORT_ROLE_ID=

# Optional: channel where closed-ticket transcripts are posted
TICKET_LOG_CHANNEL_ID=
